PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/gerar-carnes
MONGODB_DB_NAME=gerar-carnes

APP_USERNAME=admin
APP_PASSWORD=troque-esta-senha
APP_TOKEN_SECRET=troque-este-segredo-longo

BOLETO_BENEFICIARY_NAME=Sua empresa
BOLETO_BENEFICIARY_DOCUMENT=00000000000100
BOLETO_AGENCY_CODE=0001/00000000-0
BOLETO_BANK_CODE=077-9
BOLETO_BANK_NAME=Banco Inter

# mock para desenvolvimento, real para Banco Inter
INTER_MODE=mock
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_SCOPE=boleto-cobranca.write boleto-cobranca.read
INTER_CERT_PATH=
INTER_KEY_PATH=

# Preferivel na Vercel, porque arquivos de certificado nao ficam no servidor.
# Gere com: certutil -encode certificado.crt cert.base64.txt
# Remova as linhas BEGIN/END se usar certutil.
INTER_CERT_BASE64=
INTER_KEY_BASE64=
INTER_PFX_PATH=
INTER_PFX_BASE64=
INTER_PFX_PASSPHRASE=
INTER_MULTA_PERCENTUAL=2
INTER_MORA_PERCENTUAL=1
